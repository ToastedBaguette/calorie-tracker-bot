# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) First model to try; falls back to gemini-3.6-flash, then gemini-flash-latest
# GEMINI_MODEL=gemini-3.5-flash

# Google Sheets — spreadsheet ID or full URL. Share the sheet with the service account
# email (client_email in service_account.json) as Editor. The bot creates its tabs itself.
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# --- DISCORD CONFIGURATION ---
# Bot Token from https://discord.com/developers/applications (enable MESSAGE CONTENT INTENT)
DISCORD_TOKEN=your_discord_bot_token_here

# Channel the bot listens in. Strongly recommended so it doesn't answer in other bots' channels.
DISCORD_CHANNEL_ID=

# (Optional) Comma-separated Discord user IDs allowed to use the bot
DISCORD_AUTHORIZED_USERS=
